# =============================================================================
# Sudabelt Medical Backend - Production Environment Variables Checklist
# Copy to server/.env on Hostinger VPS and populate real secrets before deploy
# =============================================================================

# 1. Server Runtime
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://www.sudabelt.com

# 2. Database (MongoDB Atlas or Hostinger MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sudabelt-production?retryWrites=true&w=majority

# 3. Transactional Email Routing (Resend)
RESEND_API_KEY=re_your_live_resend_api_key
EMAIL_FROM=Sudabelt Medical <notifications@sudabelt.com>
SALES_DESK_EMAIL=contact@sudabelt.com
AFTER_SALES_EMAIL=support@sudabelt.com
TRAINING_EMAIL=contact@sudabelt.com
CONTACT_EMAIL=info@sudabelt.com
CAREERS_EMAIL=hrdesk@sudabelt.com

# 4. Cloudinary Media & Document CDN
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. WhatsApp Business Routing Numbers (International format without +)
WHATSAPP_SALES_NUMBER=2349135733876
WHATSAPP_BIOMEDICAL_NUMBER=2349135733876
WHATSAPP_ABUJA_NUMBER=2347064939047

# 6. Admin / CRM Authentication (Generate strong secrets for production!)
ADMIN_EMAIL=admin@sudabelt.com
ADMIN_PASSWORD=ReplaceWithStrongProductionPassword!
ADMIN_NAME=Sudabelt Administrator
ADMIN_API_KEY=ReplaceWithRandom32ByteHexKey
JWT_SECRET=ReplaceWithRandom64ByteHexSecret
